# Which extractor to use: "anthropic" or "openai" (real LLMs), or "heuristic" (rule-based baseline, no network).
LLM_PROVIDER=heuristic

# Required only when LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# If set, every /v1 request must send this value in the X-API-Key header.
AGENT_API_KEY=

# Where updates and proposed actions are stored.
DATABASE_PATH=data/agent.db

# Messages are stored and logged with phone numbers and emails redacted.
# Set to true only for local debugging with fictional data.
STORE_RAW_MESSAGES=false
MAX_MESSAGE_CHARS=2000

# Only when LLM_PROVIDER=openai (install with: pip install -e ".[openai]").
OPENAI_API_KEY=
# Required for the OpenAI provider; there is deliberately no default model.
OPENAI_MODEL=
